# Токен бота Telegram, отриманий від @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram ID адміністраторів через кому
ADMIN_IDS=123456789

# Публічний URL для Telegram WebApp (якщо порожній, run.py спробує отримати його через cloudflared)
WEBAPP_URL=

# Порт HTTP сервера (8000 зайнятий іншими сервісами)
PORT=8765

# DEV режим: true дозволяє тестувати в браузері без Telegram з фіктивним користувачем
DEV_MODE=true

# Режим кулдауну: REAL (2 години), SIMULATION (2 хвилини), DEBUG (10 секунд)
APP_MODE=DEBUG
